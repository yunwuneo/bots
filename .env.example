# Base URL includes the API prefix, usually /v1. Model must support tool calls.
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_NAME=your-model-name
MODEL_API_KEY=
# A password for the web UI and a separate random secret for the execution service.
NEOBOTS_PASSWORD=
NEOBOTS_RUNTIME_TOKEN=
# Access from Windows at http://localhost:18787
NEOBOTS_PORT=18787

